# NVIDIA NIM Endpoint Configuration (Optional)
# If NIM_TOKEN is set, all completions are routed through NVIDIA NIM.
# If not set, aiask falls back to using standard GitHub Copilot.

NIM_TOKEN=your_nvapi_token_here
NIM_MODEL=meta/llama-3.1-8b-instruct
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
